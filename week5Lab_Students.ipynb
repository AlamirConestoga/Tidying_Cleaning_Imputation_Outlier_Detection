    "        cars_drop_columns.isnull().sum().sum(),\n",
    "        cars_mean.isnull().sum().sum(),\n",
    "        cars_median.isnull().sum().sum(),\n",
    "        cars_mode.isnull().sum().sum()\n",
    "    ]\n",
    "})\n",
    "\n",
    "display(comparison)\n"
   ]
